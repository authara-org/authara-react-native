# Public hostname configured for the Cloudflare Tunnel route.
AUTHARA_PUBLIC_URL=https://playground.authara.org
AUTHARA_ORG_MODE=multi

# Copy only the eyJ... token from the tunnel's Docker installation command.
CLOUDFLARE_TUNNEL_TOKEN=

# Released images make the playground self-contained. Set
# AUTHARA_EXAMPLE_CORE_DIR only when testing an unreleased Core checkout.
AUTHARA_CORE_VERSION=v0.25.0
AUTHARA_MIGRATIONS_VERSION=v0.3.0
AUTHARA_EXAMPLE_CORE_DIR=

# These avoid collisions with Authara Core's own development Compose stack.
AUTHARA_GATEWAY_PORT=3002
AUTHARA_MAILPIT_SMTP_PORT=1026
AUTHARA_MAILPIT_HTTP_PORT=8026

# Enable providers after their consoles are configured, for example:
# AUTHARA_OAUTH_PROVIDERS=google,apple,microsoft
AUTHARA_OAUTH_PROVIDERS=

# Google uses the existing web client as the backend audience and a separate
# public iOS client for the native application bundle.
AUTHARA_OAUTH_GOOGLE_CLIENT_ID=
AUTHARA_OAUTH_GOOGLE_CLIENT_SECRET=
AUTHARA_OAUTH_GOOGLE_IOS_CLIENT_ID=

AUTHARA_OAUTH_MICROSOFT_CLIENT_ID=
AUTHARA_OAUTH_MICROSOFT_TENANT_ID=common

# Current Core accepts one Apple client ID per instance. This mobile playground
# uses the native App ID when present; otherwise it reuses APPLE_CLIENT_ID as
# the app bundle ID. The effective value must be an Apple App ID with Sign in
# with Apple enabled.
AUTHARA_OAUTH_APPLE_CLIENT_ID=
AUTHARA_OAUTH_APPLE_IOS_CLIENT_ID=
AUTHARA_OAUTH_APPLE_TEAM_ID=
AUTHARA_OAUTH_APPLE_KEY_ID=
AUTHARA_OAUTH_APPLE_PRIVATE_KEY_BASE64=
AUTHARA_OAUTH_APPLE_TOKEN_ACTIVE_KEY_ID=
AUTHARA_OAUTH_APPLE_TOKEN_KEYS=
